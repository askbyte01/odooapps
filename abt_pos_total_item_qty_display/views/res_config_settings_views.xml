<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherited_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.point_of_sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_total_qty"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_total_qty" string="Show Total Quantity?"/>
                        <div class="text-muted">
                             Display the total quantity of items.
                        </div>
                    </div>
                </div>
                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_total_items"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_total_items" string="Show Total Items?"/>
                        <div class="text-muted">
                            Display the total number of items.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
